{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/adaouat/heraut/main/schema.json",
  "title": "heraut",
  "description": "Configuration file for heraut (.heraut.yml).",
  "type": "object",
  "required": [
    "version",
    "versioning"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1",
      "description": "Schema version. Must be \"1\"."
    },
    "versioning": {
      "$ref": "#/definitions/Versioning"
    },
    "changelog": {
      "$ref": "#/definitions/ContentDriver"
    },
    "release": {
      "$ref": "#/definitions/Release"
    },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Environment"
      },
      "description": "Per-environment configuration. Required for semver-per-env and calver-per-env strategies."
    }
  },
  "definitions": {
    "Versioning": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "semver",
            "calver",
            "semver-per-env",
            "calver-per-env"
          ],
          "description": "Versioning strategy."
        },
        "tag_prefix": {
          "type": "string",
          "description": "Tag prefix (e.g. \"v\"). Set to \"\" for bare version tags."
        },
        "initial_version": {
          "type": "string",
          "description": "Version used when no tags exist yet. SemVer strategies only."
        },
        "bump": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "description": "Bump mode. \"auto\" infers from conventional commits. SemVer strategies only."
        },
        "format": {
          "type": "string",
          "description": "CalVer format string (e.g. \"YYYY.MM.PATCH\"). Required for calver strategies."
        },
        "sprint": {
          "type": "integer",
          "minimum": 1,
          "description": "Current sprint counter. Required when format contains SPRINT. Advance with heraut version sprint bump."
        },
        "tag_format": {
          "type": "string",
          "description": "Common tag format template for per-env strategies (e.g. \"{env}/{version}\")."
        },
        "tag_type": {
          "type": "string",
          "enum": [
            "annotated",
            "lightweight"
          ],
          "description": "Git tag type. \"annotated\" (default) creates tags with a tagger, timestamp, and message. \"lightweight\" creates bare ref tags."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "enum": [
                  "calver",
                  "calver-per-env"
                ]
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "format"
            ]
          }
        }
      ]
    },
    "ContentDriver": {
      "type": "object",
      "required": [
        "generator"
      ],
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string",
          "enum": [
            "git-cliff",
            "communique",
            "cocogitto"
          ],
          "description": "Content generator."
        },
        "config": {
          "type": "string",
          "description": "Path to a generator-specific config file."
        },
        "output": {
          "type": "string",
          "description": "Changelog output file path (e.g. \"CHANGELOG.md\")."
        },
        "tag_pattern": {
          "type": "string",
          "description": "Git tag glob for filtering commits (e.g. \"dev/*\")."
        },
        "template": {
          "type": "string",
          "description": "Template path override."
        }
      }
    },
    "Release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "$ref": "#/definitions/ContentDriver"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Platform"
          }
        },
        "assets": {
          "type": "array",
          "description": "Glob patterns for files to attach to the release, applied to all platforms. Globs are expanded at release time; a pattern matching nothing emits a warning but does not abort the release. If a platform entry also defines assets, the platform-level list takes full precedence for that platform (no merging).",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Platform": {
      "type": "object",
      "required": [
        "platform"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "description": "Platform type."
        },
        "repository": {
          "type": "string",
          "description": "GitHub repository (owner/repo). GitHub only."
        },
        "draft": {
          "type": "boolean",
          "description": "Create as draft release. GitHub only."
        },
        "prerelease": {
          "type": "boolean",
          "description": "Mark as pre-release. GitHub only."
        },
        "project": {
          "type": "string",
          "description": "GitLab project path (namespace/project). GitLab only."
        },
        "token_env": {
          "type": "string",
          "description": "Environment variable holding the API token."
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Platform-specific glob patterns for files to attach to the release. When set, overrides release.assets entirely for this platform. Omit to inherit release.assets."
        }
      }
    },
    "EnvRelease": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-environment release overrides. Absent fields inherit from root release.",
      "properties": {
        "notes": {
          "$ref": "#/definitions/ContentDriver",
          "description": "Override release notes generator for this environment."
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Platform"
          },
          "description": "Override platforms for this environment."
        }
      }
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-environment configuration. Versioning fields drive version resolution; content fields override changelog/release.",
      "properties": {
        "bump": {
          "type": "string",
          "enum": [
            "auto",
            "promote"
          ],
          "description": "Bump mode for this environment."
        },
        "tag_format": {
          "type": "string",
          "description": "Per-environment tag format (e.g. \"dev/{version}\"). Must contain {version}."
        },
        "branch": {
          "type": "string",
          "description": "Branch restriction for this environment."
        },
        "source": {
          "type": "string",
          "description": "Source environment for promote bump mode."
        },
        "disable_changelog": {
          "type": "boolean",
          "description": "Disable changelog generation for this environment."
        },
        "disable_notes": {
          "type": "boolean",
          "description": "Disable release notes for this environment."
        },
        "changelog": {
          "$ref": "#/definitions/ContentDriver",
          "description": "Override changelog generator for this environment."
        },
        "release": {
          "$ref": "#/definitions/EnvRelease",
          "description": "Override release settings for this environment."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "versioning": {
            "properties": {
              "strategy": {
                "enum": [
                  "semver-per-env",
                  "calver-per-env"
                ]
              }
            },
            "required": [
              "strategy"
            ]
          }
        },
        "required": [
          "versioning"
        ]
      },
      "then": {
        "required": [
          "environments"
        ]
      }
    }
  ]
}
